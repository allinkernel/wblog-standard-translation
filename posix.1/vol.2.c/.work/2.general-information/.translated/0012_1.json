[
{"index": 1, "translated_text": "[A1836][/A1836]2.11 数据类型 (Data Types)"},
{"index": 2, "translated_text": "[A1837][/A1837]2.11.1 已定义类型 (Defined Types)"},
{"index": 3, "translated_text": "各函数所使用的所有数据类型均由实现定义。下表描述了其中一些类型。在某个函数的描述中引用但此处未提及的其他类型，可以在该函数相应的头文件中找到。"},
{"index": 4, "translated_text": "[B1838]cc_t[/B1838]"},
{"index": 5, "translated_text": "用于终端特殊字符的类型。"},
{"index": 6, "translated_text": "[B1839]clock_t[/B1839]"},
{"index": 7, "translated_text": "用于处理器时间的整数或实数浮点类型，如 ISO&nbsp;C 标准中所定义。"},
{"index": 8, "translated_text": "[B1840]clockid_t[/B1840]"},
{"index": 9, "translated_text": "用于某些定时器函数中的时钟 ID 类型。"},
{"index": 10, "translated_text": "[B1841]dev_t[/B1841]"},
{"index": 11, "translated_text": "用于设备号的整数类型。"},
{"index": 12, "translated_text": "[B1842]DIR[/B1842]"},
{"index": 13, "translated_text": "表示目录流的类型。"},
{"index": 14, "translated_text": "[B1843]div_t[/B1843]"},
{"index": 15, "translated_text": "由 [I1844]div[/I1844]() 函数返回的结构类型。"},
{"index": 16, "translated_text": "[B1845]FILE[/B1845]"},
{"index": 17, "translated_text": "包含关于某个文件信息的结构。"},
{"index": 18, "translated_text": "[B1846]glob_t[/B1846]"},
{"index": 19, "translated_text": "用于路径名模式匹配的结构类型。"},
{"index": 20, "translated_text": "[B1847]fpos_t[/B1847]"},
{"index": 21, "translated_text": "包含唯一定位文件中每个位置所需的全部信息的类型。"},
{"index": 22, "translated_text": "[B1848]gid_t[/B1848]"},
{"index": 23, "translated_text": "用于组 ID 的整数类型。"},
{"index": 24, "translated_text": "[B1849]iconv_t[/B1849]"},
{"index": 25, "translated_text": "用于转换描述符的类型。"},
{"index": 26, "translated_text": "[B1850]id_t[/B1850]"},
{"index": 27, "translated_text": "用作通用标识符的整数类型；可以用于容纳 [B1851]pid_t[/B1851]、[B1852]uid_t[/B1852] 或 [B1853]gid_t[/B1853] 中至少最大的一个。"},
{"index": 28, "translated_text": "[B1854]ino_t[/B1854]"},
{"index": 29, "translated_text": "用于文件序列号的无符号整数类型。"},
{"index": 30, "translated_text": "[B1855]key_t[/B1855]"},
{"index": 31, "translated_text": "用于 XSI 进程间通信的算术类型。"},
{"index": 32, "translated_text": "[B1856]ldiv_t[/B1856]"},
{"index": 33, "translated_text": "由 [I1857]ldiv[/I1857]() 函数返回的结构类型。"},
{"index": 34, "translated_text": "[B1858]mode_t[/B1858]"},
{"index": 35, "translated_text": "用于文件属性的整数类型。"},
{"index": 36, "translated_text": "[B1859]mqd_t[/B1859]"},
{"index": 37, "translated_text": "用于消息队列描述符。"},
{"index": 38, "translated_text": "[B1860]nfds_t[/B1860]"},
{"index": 39, "translated_text": "用于文件描述符数目的整数类型。"},
{"index": 40, "translated_text": "[B1861]nlink_t[/B1861]"}
]
