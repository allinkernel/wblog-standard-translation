   {
    "id": "p_00038",
    "type": "p",
    "path": [
     2,
     3,
     69,
     1
    ],
    "text": "Austin Group Defect 792 is applied, adding a requirement that passing the thread ID of a zombie thread to\n[I53]pthread_cancel[/I53]() is not treated as an error.",
    "placeholders": {
     "I53": {
      "open": "<i>",
