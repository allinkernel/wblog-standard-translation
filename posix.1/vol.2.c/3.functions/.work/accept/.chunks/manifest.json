   {
    "id": "h4_00063",
    "type": "h4",
    "path": [
     2,
     3,
     39
    ],
    "text": "[A59][/A59]APPLICATION USAGE",
    "placeholders": {
     "A59": {
      "open": "<a name=\"tag_17_06_07\" id=\"tag_17_06_07\">",
      "close": "</a>",
      "translate": true
     }
