    "type": "dd",
    "path": [
     2,
     3,
     2,
     29,
     3,
     21
    ],
    "text": "A signal was caught during execution.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dt_00029",
    "type": "dt",
    "path": [
     2,
     3,
     2,
     29,
     3,
     23
    ],
    "text": "[EINVAL]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00030",
    "type": "dd",
    "path": [
     2,
     3,
     2,
     29,
     3,
     25
    ],
    "text": "The [I48]length[/I48] argument is less than 0 or the [I49]fildes[/I49] argument refers to a file on which this operation is not\npossible (for example, a pipe, FIFO or socket).",
    "placeholders": {
     "I48": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I49": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "dt_00031",
    "type": "dt",
    "path": [
     2,
     3,
     2,
