    "placeholders": {},
    "context": null
   },
   {
    "id": "dt_00046",
    "type": "dt",
    "path": [
     2,
     3,
     29,
     3,
     47
    ],
    "text": "[ETIMEDOUT]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00047",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     3,
     49
    ],
    "text": "The attempt to connect timed out before a connection was made.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00048",
    "type": "p",
    "path": [
     2,
     3,
     29,
     5
    ],
    "text": "If the address family of the socket is AF_UNIX, then [I52]connect[/I52]() shall fail if:",
    "placeholders": {
     "I52": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "dt_00049",
    "type": "dt",
    "path": [
     2,
     3,
     29,
     7,
     3
    ],
    "text": "[EIO]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00050",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     7,
     5
    ],
    "text": "An I/O error occurred while reading from or writing to the file system.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dt_00051",
    "type": "dt",
    "path": [
     2,
     3,
     29,
     7,
     7
    ],
    "text": "[ELOOP]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00052",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     7,
     9
    ],
    "text": "A loop exists in symbolic links encountered during resolution of the pathname in [I53]address[/I53].",
    "placeholders": {
     "I53": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "dt_00053",
    "type": "dt",
    "path": [
     2,
