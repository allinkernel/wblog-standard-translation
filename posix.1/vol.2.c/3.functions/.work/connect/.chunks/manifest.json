   },
   {
    "id": "dd_00056",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     7,
     17
    ],
    "text": "A component of the pathname does not name an existing file or the pathname is an empty string.",
    "placeholders": {},
    "context": null
   },
