    ],
    "text": "[ENOTSOCK]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00043",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     3,
     41
    ],
    "text": "The [I51]socket[/I51] argument does not refer to a socket.",
