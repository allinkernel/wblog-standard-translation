   {
    "id": "p_00083",
    "type": "p",
    "path": [
     2,
     3,
     41,
     1
    ],
    "text": "If [I62]connect[/I62]() fails, the state of the socket is unspecified. Conforming applications should close the file descriptor and\ncreate a new socket before attempting to reconnect.",
    "placeholders": {
     "I62": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
