    ],
    "text": "[CODE3]",
    "placeholders": {
     "CODE3": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<code><tt>#include &lt;<a href=\"../basedefs/stdio.h.html\">stdio.h</a>&gt;<br>\n<br>\nchar *fgets(char *restrict</tt> <i>s</i><tt>, int</tt> <i>n</i><tt>, FILE *restrict</tt> <i>stream</i><tt>);<br></tt></code>"
