   {
    "id": "h4_00005",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     19
    ],
    "text": "[A4][/A4]DESCRIPTION",
    "placeholders": {
     "A4": {
      "open": "<a name=\"tag_17_158_03\" id=\"tag_17_158_03\">",
      "close": "</a>",
      "translate": true
     }
