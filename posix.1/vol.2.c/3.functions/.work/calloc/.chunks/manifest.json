    "type": "h4",
    "path": [
     2,
     3,
     2,
     23
    ],
    "text": "[A33][/A33]RETURN VALUE",
    "placeholders": {
     "A33": {
      "open": "<a name=\"tag_17_53_04\" id=\"tag_17_53_04\">",
      "close": "</a>",
      "translate": true
