    "id": "p_00040",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     1
    ],
    "text": "Extensions beyond the ISO&nbsp;C standard are marked.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00041",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     3
    ],
    "text": "The [I81]strtok_r[/I81]() function is marked as part of the Thread-Safe Functions option.",
    "placeholders": {
     "I81": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
