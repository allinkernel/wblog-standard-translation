    "id": "p_00037",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     1
    ],
    "text": "The [I78]strtok_r[/I78]() function is included for alignment with the POSIX Threads Extension.",
    "placeholders": {
     "I78": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00038",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     3
    ],
    "text": "A note indicating that the [I79]strtok[/I79]() function need not be reentrant is added to the DESCRIPTION.",
    "placeholders": {
     "I79": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
