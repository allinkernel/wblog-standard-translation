     }
    },
    "context": null
   },
   {
    "id": "p_00014",
    "type": "p",
    "path": [
     2,
     3,
     2,
     21,
     17
    ],
    "text": "[S42][[A43]CX[/A43]][/S42] [IMG44] The\n[I45]strtok[/I45]() and [I46]strtok_r[/I46]() functions shall not change the setting of [I47]errno[/I47] on valid input. [IMG48]",
    "placeholders": {
     "S42": {
      "open": "<sup>",
      "close": "</sup>",
      "translate": true
     },
     "A43": {
      "open": "<a href=\"javascript:open_code(&#x27;CX&#x27;)\">",
      "close": "</a>",
      "translate": true
     },
     "IMG44": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<img src=\"../images/opt-start.gif\" alt=\"[Option Start]\" border=\"0\">"
     },
     "I45": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I46": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I47": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "IMG48": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<img src=\"../images/opt-end.gif\" alt=\"[Option End]\" border=\"0\">"
     }
    },
    "context": null
   },
   {
    "id": "h4_00015",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     23
    ],
    "text": "[A49][/A49]RETURN VALUE",
    "placeholders": {
     "A49": {
      "open": "<a name=\"tag_17_592_04\" id=\"tag_17_592_04\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00016",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     1
    ],
    "text": "Upon successful completion, [I50]strtok[/I50]() shall return a pointer to the first byte of a token. Otherwise, if there is no\ntoken, [I51]strtok[/I51]() shall return a null pointer.",
    "placeholders": {
     "I50": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I51": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00017",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     3
    ],
    "text": "[S52][[A53]CX[/A53]][/S52] [IMG54] The\n[I55]strtok_r[/I55]() function shall return a pointer to the token found, or a null pointer when no token is found. [IMG56]",
    "placeholders": {
     "S52": {
      "open": "<sup>",
      "close": "</sup>",
      "translate": true
     },
     "A53": {
      "open": "<a href=\"javascript:open_code(&#x27;CX&#x27;)\">",
      "close": "</a>",
      "translate": true
     },
     "IMG54": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<img src=\"../images/opt-start.gif\" alt=\"[Option Start]\" border=\"0\">"
     },
     "I55": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "IMG56": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<img src=\"../images/opt-end.gif\" alt=\"[Option End]\" border=\"0\">"
     }
    },
    "context": null
   },
   {
    "id": "h4_00018",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     27
    ],
