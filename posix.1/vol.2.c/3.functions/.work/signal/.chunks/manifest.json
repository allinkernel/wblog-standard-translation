    "id": "p_00057",
    "type": "p",
    "path": [
     2,
     3,
     2,
     73,
     1
    ],
    "text": "Austin Group Defect 728 is applied, reducing the set of circumstances in which undefined behavior results when a signal handler\nrefers to an object with static or thread storage duration.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00058",
    "type": "p",
    "path": [
     2,
     3,
     2,
     73,
     3
    ],
    "text": "Austin Group Defect 1302 is applied, aligning this function with the ISO/IEC&nbsp;9899:2018 standard.",
    "placeholders": {},
    "context": null
   },
   {
