     "A19": {
      "open": "<a href=\"../functions/raise.html\">",
      "close": "</a>",
      "translate": true
     },
     "I20": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A21": {
      "open": "<a href=\"../functions/V2_chap02.html#tag_16_04_03\">",
      "close": "</a>",
      "translate": true
     },
     "I22": {
