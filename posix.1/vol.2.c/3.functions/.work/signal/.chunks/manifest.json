    ],
    "text": "[CODE3]",
    "placeholders": {
     "CODE3": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<code><tt>#include &lt;<a href=\"../basedefs/signal.h.html\">signal.h</a>&gt;<br>\n<br>\nvoid (*signal(int</tt> <i>sig</i><tt>, void (*</tt><i>func</i><tt>)(int)))(int);<br></tt></code>"
     }
