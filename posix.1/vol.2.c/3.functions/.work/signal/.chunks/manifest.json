   {
    "id": "p_00014",
    "type": "p",
    "path": [
     2,
     3,
     2,
     21,
     21,
     1,
     1
    ],
    "text": "The signal handler refers to any object [S46][[A47]CX[/A47]][/S46] [IMG48] &nbsp;other than [I49]errno[/I49] [IMG50] &nbsp;with static or thread storage duration that is not a lock-free atomic object, [S51][[A52]CX[/A52]][/S51] [IMG53] &nbsp;and not a\nnon-modifiable object (for example, string literals, objects that were defined with a const-qualified type, and objects in memory\nthat is mapped read-only), [IMG54] &nbsp;other than by assigning a value to\nan object declared as [B55]volatile sig_atomic_t[/B55], [S56][[A57]CX[/A57]][/S56] [IMG58] &nbsp;unless the previous modification (if any) to the object happens\nbefore the signal handler is called and the return from the signal handler happens before the next modification (if any) to the\nobject. [IMG59]",
    "placeholders": {
     "S46": {
      "open": "<sup>",
      "close": "</sup>",
      "translate": true
     },
     "A47": {
