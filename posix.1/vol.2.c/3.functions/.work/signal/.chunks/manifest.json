      "close": "</i>",
      "translate": true
     },
     "I137": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "h4_00053",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     67
    ],
    "text": "[A138][/A138]Issue 7",
    "placeholders": {
     "A138": {
      "open": "<a name=\"tag_17_552_14\" id=\"tag_17_552_14\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00054",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     1
    ],
    "text": "POSIX.1-2008, Technical Corrigendum 1, XSH/TC1-2008/0580 [275], XSH/TC1-2008/0581 [66], and XSH/TC1-2008/0582 [105] are\napplied.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00055",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     3
    ],
    "text": "POSIX.1-2008, Technical Corrigendum 2, XSH/TC2-2008/0331 [785] is applied.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00056",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     71
    ],
    "text": "[A139][/A139]Issue 8",
    "placeholders": {
     "A139": {
      "open": "<a name=\"tag_17_552_15\" id=\"tag_17_552_15\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
