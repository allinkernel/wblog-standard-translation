    "id": "p_00107",
    "type": "p",
    "path": [
     2,
     3,
     2,
     73,
     7
    ],
    "text": "Austin Group Defect 1385 is applied, clarifying that the file contents are not removed until there are no references to the file\nvia open file descriptors or memory mappings.",
    "placeholders": {},
    "context": null
