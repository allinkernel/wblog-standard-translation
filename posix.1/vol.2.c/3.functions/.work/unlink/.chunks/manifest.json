    "id": "p_00104",
    "type": "p",
    "path": [
     2,
     3,
     2,
     73,
     1
    ],
    "text": "Austin Group Defect 1314 is applied, clarifying that file identities become available for reuse after the space occupied by the\nfile has been freed.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00105",
    "type": "p",
    "path": [
     2,
     3,
     2,
     73,
     3
    ],
    "text": "Austin Group Defect 1330 is applied, removing obsolescent interfaces.",
