      "translate": false,
      "raw": "<code><tt>#include &lt;<a href=\"../basedefs/stdlib.h.html\">stdlib.h</a>&gt;<br>\n<br>\nvoid *realloc(void *</tt><i>ptr</i><tt>, size_t</tt> <i>size</i><tt>);<br></tt></code>"
