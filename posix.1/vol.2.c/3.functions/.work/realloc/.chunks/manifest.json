   {
    "id": "p_00014",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     1
    ],
    "text": "Upon successful completion, [I95]realloc[/I95]() [S96][[A97]CX[/A97]][/S96] [IMG98] &nbsp;and [I99]reallocarray[/I99]() [IMG100] &nbsp;shall return a pointer to the new object (which can have the same value as a pointer to the old\nobject), or a null pointer if the new object has not been allocated.",
    "placeholders": {
     "I95": {
      "open": "<i>",
      "close": "</i>",
