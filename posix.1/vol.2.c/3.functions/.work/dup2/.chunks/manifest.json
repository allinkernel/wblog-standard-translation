    "id": "p_00008",
    "type": "p",
    "path": [
     2,
     3,
     2,
     21,
     7
    ],
    "text": "Upon successful completion, if [I28]fildes[/I28] is not equal to [I29]fildes2[/I29], the FD_CLOEXEC and FD_CLOFORK flags associated with\n[I30]fildes2[/I30] shall be cleared. If [I31]fildes[/I31] is equal to [I32]fildes2[/I32], the FD_CLOEXEC and FD_CLOFORK flags associated with\n[I33]fildes2[/I33] shall not be changed.",
    "placeholders": {
     "I28": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I29": {
