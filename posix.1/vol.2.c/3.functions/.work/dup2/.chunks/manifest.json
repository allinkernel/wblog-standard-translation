    ],
    "text": "[CODE3]",
    "placeholders": {
     "CODE3": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<code><tt>#include &lt;<a href=\"../basedefs/unistd.h.html\">unistd.h</a>&gt;<br>\n<br>\nint dup(int</tt> <i>fildes</i><tt>);<br>\nint dup2(int</tt> <i>fildes</i><tt>, int</tt> <i>fildes2</i><tt>);<br>\nint dup3(int</tt> <i>fildes</i><tt>, int</tt> <i>fildes2</i><tt>, int</tt> <i>flag</i><tt>);<br></tt></code>"
     }
    },
