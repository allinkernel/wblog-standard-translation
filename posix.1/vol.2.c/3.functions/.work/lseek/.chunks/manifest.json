   },
   {
    "id": "p_00056",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     3
    ],
    "text": "The following new requirements on POSIX implementations derive from alignment with the Single UNIX Specification:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00057",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     1,
     1
    ],
    "text": "The requirement to include [A88][I89]&lt;sys/types.h&gt;[/I89][/A88] has been removed. Although\n[A90][I91]&lt;sys/types.h&gt;[/I91][/A90] was required for conforming implementations of previous POSIX\nspecifications, it was not required for UNIX applications.",
    "placeholders": {
     "A88": {
      "open": "<a href=\"../basedefs/sys_types.h.html\">",
      "close": "</a>",
      "translate": true
     },
     "I89": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A90": {
      "open": "<a href=\"../basedefs/sys_types.h.html\">",
      "close": "</a>",
      "translate": true
     },
     "I91": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00058",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     3,
     1
    ],
    "text": "The [EOVERFLOW] error condition is added. This change is to support large files.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00059",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     7
    ],
    "text": "An additional [ESPIPE] error condition is added for sockets.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00060",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     9
    ],
    "text": "The DESCRIPTION is updated for alignment with IEEE&nbsp;Std&nbsp;1003.1j-2000 by specifying that [I92]lseek[/I92]() results are\nunspecified for typed memory objects.",
    "placeholders": {
     "I92": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
