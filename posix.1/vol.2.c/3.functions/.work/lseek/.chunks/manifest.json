   {
    "id": "p_00055",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     1
    ],
    "text": "In the SYNOPSIS, the optional include of the [A86][I87]&lt;sys/types.h&gt;[/I87][/A86] header is\nremoved.",
    "placeholders": {
     "A86": {
      "open": "<a href=\"../basedefs/sys_types.h.html\">",
