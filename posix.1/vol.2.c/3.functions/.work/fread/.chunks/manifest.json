   {
    "id": "p_00009",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     1
    ],
    "text": "The [I41]fread[/I41]() function shall return the number of elements successfully read, which shall be less than [I42]nitems[/I42] only\nif an error or end-of-file is encountered, or [I43]size[/I43] is zero. If [I44]size[/I44] or [I45]nitems[/I45] is 0, [I46]fread[/I46]() shall\nreturn 0 and the contents of the array and the state of the stream shall remain unchanged. Otherwise, if an error occurs, the error\nindicator for the stream shall be set, [S47][[A48]CX[/A48]][/S47] [IMG49] &nbsp;and [I50]errno[/I50] shall be set to indicate the error. [IMG51]",
    "placeholders": {
     "I41": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I42": {
