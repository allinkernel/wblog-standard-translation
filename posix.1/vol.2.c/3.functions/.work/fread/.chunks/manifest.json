   {
    "id": "h5_00013",
    "type": "h5",
    "path": [
     2,
     3,
     2,
     37,
     1
    ],
    "text": "[A56][/A56]Reading from a Stream",
    "placeholders": {
     "A56": {
      "open": "<a name=\"tag_17_180_06_01\" id=\"tag_17_180_06_01\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00014",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     3
    ],
    "text": "The following example transfers a single 100-byte fixed length record from the [I57]fp[/I57] stream into the array pointed to by\n[I58]buf[/I58].",
    "placeholders": {
     "I57": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I58": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00015",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     7
    ],
    "text": "If a read error occurs, [I59]elements_read[/I59] will be zero but the number of bytes read from the stream could be anything from\nzero to [I60]sizeof[/I60]([I61]buf[/I61])-1.",
    "placeholders": {
     "I59": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I60": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I61": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00016",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     9
    ],
    "text": "The following example reads multiple single-byte elements from the [I62]fp[/I62] stream into the array pointed to by [I63]buf[/I63].",
    "placeholders": {
     "I62": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I63": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00017",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     13
    ],
    "text": "If a read error occurs, [I64]bytes_read[/I64] will contain the number of bytes read from the stream.",
    "placeholders": {
     "I64": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "h4_00018",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     39
    ],
    "text": "[A65][/A65]APPLICATION USAGE",
    "placeholders": {
     "A65": {
      "open": "<a name=\"tag_17_180_07\" id=\"tag_17_180_07\">",
      "close": "</a>",
      "translate": true
     }
