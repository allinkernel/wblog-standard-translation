   },
   {
    "id": "p_00041",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     3
    ],
    "text": "Aligned with [I67]munmap[/I67]() in the POSIX Realtime Extension as follows:",
    "placeholders": {
     "I67": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00042",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     5,
     1,
     1
    ],
    "text": "The DESCRIPTION is extensively reworded.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00043",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     5,
     3,
     1
    ],
    "text": "The SIGBUS error is no longer permitted to be generated.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00044",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     63
    ],
    "text": "[A68][/A68]Issue 6",
    "placeholders": {
     "A68": {
      "open": "<a name=\"tag_17_363_13\" id=\"tag_17_363_13\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00045",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     1
    ],
    "text": "The [I69]munmap[/I69]() function is marked as part of the Memory Mapped Files and Shared Memory Objects option.",
    "placeholders": {
     "I69": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00046",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     3
    ],
    "text": "The following new requirements on POSIX implementations derive from alignment with the Single UNIX Specification:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00047",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     1,
     1
    ],
    "text": "The DESCRIPTION is updated to state that implementations require [I70]addr[/I70] to be a multiple of the page size.",
    "placeholders": {
     "I70": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00048",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     3,
     1
    ],
    "text": "The [EINVAL] error conditions are added.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00049",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     7
    ],
    "text": "The following changes are made for alignment with IEEE&nbsp;Std&nbsp;1003.1j-2000:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00050",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     9,
     1,
     1
    ],
    "text": "Semantics for typed memory objects are added to the DESCRIPTION.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00051",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     9,
     3,
     1
    ],
    "text": "The [A71][I72]posix_typed_mem_open[/I72]()[/A71] function is added to the SEE ALSO\nsection.",
    "placeholders": {
     "A71": {
      "open": "<a href=\"../functions/posix_typed_mem_open.html\">",
      "close": "</a>",
      "translate": true
     },
     "I72": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00052",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     11
    ],
    "text": "IEEE&nbsp;Std&nbsp;1003.1-2001/Cor&nbsp;1-2002, item XSH/TC1/D6/36 is applied, changing the margin code in the SYNOPSIS from\nMF|SHM to MC3 (notation for MF|SHM|TYM).",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00053",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     67
    ],
    "text": "[A73][/A73]Issue 7",
    "placeholders": {
     "A73": {
      "open": "<a name=\"tag_17_363_14\" id=\"tag_17_363_14\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00054",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     1
    ],
    "text": "Austin Group Interpretation 1003.1-2001 #078 is applied, clarifying page alignment requirements.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00055",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     3
    ],
    "text": "The [I74]munmap[/I74]() function is moved from the Memory Mapped Files option to the Base.",
    "placeholders": {
     "I74": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00056",
    "type": "p",
    "path": [
     2,
     3,
     2,
     75
    ],
    "text": "&nbsp;",
    "placeholders": {},
    "context": null
   }
  ]
 }
