[{"index": 1, "translated_text": "[A1][/A1]名称 (NAME)"},
{"index": 2, "translated_text": "getpid — 获取进程 ID (get the process ID)"},
{"index": 3, "translated_text": "[A2][/A2]概要 (SYNOPSIS)"},
{"index": 4, "translated_text": "[CODE3]"},
{"index": 5, "translated_text": "[A4][/A4]说明 (DESCRIPTION)"},
{"index": 6, "translated_text": "[I5]getpid[/I5]() 函数应返回调用进程的进程 ID。"},
{"index": 7, "translated_text": "[A6][/A6]返回值 (RETURN VALUE)"},
{"index": 8, "translated_text": "[I7]getpid[/I7]() 函数应始终成功，并且没有保留返回值来指示错误。"},
{"index": 9, "translated_text": "[A8][/A8]错误 (ERRORS)"},
{"index": 10, "translated_text": "未定义任何错误。"},
{"index": 11, "translated_text": "[A9][/A9]示例 (EXAMPLES)"},
{"index": 12, "translated_text": "无。"},
{"index": 13, "translated_text": "[A10][/A10]应用程序用法 (APPLICATION USAGE)"},
{"index": 14, "translated_text": "无。"},
