   {
    "id": "p_00006",
    "type": "p",
    "path": [
     2,
     3,
     21,
     1
    ],
    "text": "The [I5]getpid[/I5]() function shall return the process ID of the calling process.",
    "placeholders": {
     "I5": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
