    "context": null
   },
   {
    "id": "p_00008",
    "type": "p",
    "path": [
     2,
     3,
     25,
     1
    ],
    "text": "The [I7]getpid[/I7]() function shall always be successful and no return value is reserved to indicate an error.",
    "placeholders": {
     "I7": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
