    "id": "p_00051",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     9
    ],
    "text": "The following changes are made for alignment with the ISO/IEC&nbsp;9899:1999 standard:",
    "placeholders": {},
    "context": null
