    "id": "p_00050",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     1,
     1
    ],
    "text": "In the RETURN VALUE and ERRORS sections, the [EINVAL] optional error condition is added if no conversion could be performed.",
    "placeholders": {},
    "context": null
   },
