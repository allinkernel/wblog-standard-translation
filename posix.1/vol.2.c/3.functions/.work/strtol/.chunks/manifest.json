   },
   {
    "id": "h4_00032",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     35
    ],
    "text": "[A64][/A64]EXAMPLES",
    "placeholders": {
     "A64": {
      "open": "<a name=\"tag_17_593_06\" id=\"tag_17_593_06\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00033",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     1
    ],
    "text": "None.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00034",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     39
    ],
    "text": "[A65][/A65]APPLICATION USAGE",
    "placeholders": {
     "A65": {
      "open": "<a name=\"tag_17_593_07\" id=\"tag_17_593_07\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00035",
    "type": "p",
    "path": [
     2,
     3,
     2,
     41,
     1
    ],
    "text": "Since the value of [I66]*endptr[/I66] is unspecified if the value of [I67]base[/I67] is not supported, applications should either ensure\nthat [I68]base[/I68] has a supported value (0 or between 2 and 36) before the call, or check for an [EINVAL] error before examining\n[I69]*endptr[/I69].",
    "placeholders": {
     "I66": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I67": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I68": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I69": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "h4_00036",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     43
    ],
    "text": "[A70][/A70]RATIONALE",
    "placeholders": {
     "A70": {
      "open": "<a name=\"tag_17_593_08\" id=\"tag_17_593_08\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00037",
    "type": "p",
    "path": [
     2,
     3,
     2,
     45,
     1
    ],
    "text": "None.",
