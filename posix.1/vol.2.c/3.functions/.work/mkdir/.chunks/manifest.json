    "id": "dd_00047",
    "type": "dd",
    "path": [
     2,
     3,
     2,
     29,
     11,
     5
    ],
    "text": "More than {SYMLOOP_MAX} symbolic links were encountered during resolution of the [I43]path[/I43] argument.",
    "placeholders": {
     "I43": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "dt_00048",
    "type": "dt",
    "path": [
     2,
     3,
     2,
     29,
     11,
     7
