      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00065",
    "type": "p",
    "path": [
     2,
     3,
     2,
     53,
     3
    ],
    "text": "XBD [A68][I69]&lt;fcntl.h&gt;[/I69][/A68], [A70][I71]&lt;sys/stat.h&gt;[/I71][/A70], [A72][I73]&lt;sys/types.h&gt;[/I73][/A72]",
    "placeholders": {
     "A68": {
      "open": "<a href=\"../basedefs/fcntl.h.html\">",
      "close": "</a>",
      "translate": true
     },
     "I69": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A70": {
      "open": "<a href=\"../basedefs/sys_stat.h.html\">",
      "close": "</a>",
      "translate": true
     },
     "I71": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A72": {
