      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00051",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     1
    ],
    "text": "Large File Summit extensions are added.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00052",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     63
    ],
    "text": "[A111][/A111]Issue 6",
    "placeholders": {
     "A111": {
      "open": "<a name=\"tag_17_154_13\" id=\"tag_17_154_13\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00053",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     1
    ],
    "text": "Extensions beyond the ISO&nbsp;C standard are marked.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00054",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     3
    ],
    "text": "The following new requirements on POSIX implementations derive from alignment with the Single UNIX Specification:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00055",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     1,
     1
    ],
    "text": "The [EFBIG] error is added as part of the large file support extensions.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00056",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     3,
     1
    ],
    "text": "The [ENXIO] optional error condition is added.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00057",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     7
    ],
    "text": "The RETURN VALUE section is updated to note that the error indicator shall be set for the stream. This is for alignment with the\nISO/IEC&nbsp;9899:1999 standard.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00058",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     9
    ],
    "text": "IEEE&nbsp;Std&nbsp;1003.1-2001/Cor&nbsp;2-2004, item XSH/TC2/D6/31 is applied, updating the [EAGAIN] error in the ERRORS section\nfrom &quot;the process would be delayed&quot; to &quot;the thread would be delayed&quot;.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00059",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     67
    ],
    "text": "[A112][/A112]Issue 7",
    "placeholders": {
     "A112": {
      "open": "<a name=\"tag_17_154_14\" id=\"tag_17_154_14\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00060",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     1
    ],
    "text": "Austin Group Interpretation 1003.1-2001 #002 is applied, clarifying the interaction of file descriptors and streams.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00061",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     3
    ],
    "text": "The [ENOSPC] error condition is updated and the [ENOMEM] error is added from The Open Group Technical Standard, 2006, Extended\nAPI Set Part 1.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00062",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     5
    ],
    "text": "The EXAMPLES section is revised.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00063",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     7
    ],
    "text": "Changes are made related to support for finegrained timestamps.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00064",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     9
    ],
    "text": "POSIX.1-2008, Technical Corrigendum 1, XSH/TC1-2008/0126 [87], XSH/TC1-2008/0127 [79], and XSH/TC1-2008/0128 [14] are\napplied.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00065",
    "type": "p",
    "path": [
     2,
     3,
     2,
     69,
     11
    ],
    "text": "POSIX.1-2008, Technical Corrigendum 2, XSH/TC2-2008/0112 [816] and XSH/TC2-2008/0113 [626] are applied.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00066",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     71
    ],
    "text": "[A113][/A113]Issue 8",
    "placeholders": {
     "A113": {
      "open": "<a name=\"tag_17_154_15\" id=\"tag_17_154_15\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00067",
    "type": "p",
    "path": [
     2,
     3,
     2,
     73,
     1
    ],
    "text": "Austin Group Defect 308 is applied, clarifying the handling of [EFBIG] errors.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00068",
    "type": "p",
    "path": [
     2,
     3,
     2,
     73,
     3
    ],
    "text": "Austin Group Defect 1669 is applied, removing XSI shading from part of the [EFBIG] error relating to the file size limit for the\nprocess.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00069",
    "type": "p",
    "path": [
     2,
     3,
     2,
     79
    ],
    "text": "&nbsp;",
    "placeholders": {},
    "context": null
   }
  ]
 }
