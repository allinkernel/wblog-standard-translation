   {
    "id": "h4_00041",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     43
    ],
    "text": "[A93][/A93]RATIONALE",
    "placeholders": {
     "A93": {
      "open": "<a name=\"tag_17_154_08\" id=\"tag_17_154_08\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00042",
    "type": "p",
    "path": [
     2,
     3,
     2,
     45,
     1
    ],
    "text": "Data buffered by the system may make determining the validity of the position of the current file descriptor impractical. Thus,\nenforcing the repositioning of the file descriptor after [I94]fflush[/I94]() on streams open for [A95][I96]read[/I96]()[/A95] is not mandated by POSIX.1-2024.",
    "placeholders": {
     "I94": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A95": {
      "open": "<a href=\"../functions/read.html\">",
      "close": "</a>",
      "translate": true
     },
     "I96": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "h4_00043",
    "type": "h4",
    "path": [
     2,
     3,
     2,
