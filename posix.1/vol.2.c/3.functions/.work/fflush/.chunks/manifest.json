   {
    "id": "h5_00037",
    "type": "h5",
    "path": [
     2,
     3,
     2,
     37,
     1
    ],
    "text": "[A85][/A85]Sending Prompts to Standard Output",
    "placeholders": {
     "A85": {
      "open": "<a name=\"tag_17_154_06_01\" id=\"tag_17_154_06_01\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00038",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     3
    ],
    "text": "The following example uses [A86][I87]printf[/I87]()[/A86] calls to print a series of prompts for\ninformation the user must enter from standard input. The [I88]fflush[/I88]() calls force the output to standard output. The\n[I89]fflush[/I89]() function is used because standard output is usually buffered and the prompt may not immediately be printed on the\noutput or terminal. The [A90][I91]getline[/I91]()[/A90] function calls read strings from standard input\nand place the results in variables, for use later in the program.",
    "placeholders": {
     "A86": {
      "open": "<a href=\"../functions/printf.html\">",
      "close": "</a>",
      "translate": true
     },
     "I87": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I88": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I89": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A90": {
      "open": "<a href=\"../functions/getline.html\">",
      "close": "</a>",
      "translate": true
     },
     "I91": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
