    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00050",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     59
    ],
    "text": "[A110][/A110]Issue 5",
    "placeholders": {
     "A110": {
