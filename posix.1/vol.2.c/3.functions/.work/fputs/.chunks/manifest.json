      "raw": "<img src=\"../images/opt-start.gif\" alt=\"[Option Start]\" border=\"0\">"
     },
     "I11": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A12": {
      "open": "<a href=\"../functions/fflush.html\">",
      "close": "</a>",
      "translate": true
     },
     "I13": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A14": {
