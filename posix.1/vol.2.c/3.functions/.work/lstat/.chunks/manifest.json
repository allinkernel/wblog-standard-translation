   {
    "id": "h4_00064",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     43
    ],
    "text": "[A117][/A117]RATIONALE",
    "placeholders": {
     "A117": {
      "open": "<a name=\"tag_17_190_08\" id=\"tag_17_190_08\">",
      "close": "</a>",
      "translate": true
     }
