   {
    "id": "p_00021",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     1
    ],
    "text": "Upon successful completion, these functions shall return 0. Otherwise, these functions shall return -1 and set [I80]errno[/I80] to\nindicate the error.",
    "placeholders": {
