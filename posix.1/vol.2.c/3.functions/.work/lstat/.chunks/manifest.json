     },
     "B32": {
      "open": "<b>",
      "close": "</b>",
      "translate": true
     },
     "I33": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I34": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I35": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
