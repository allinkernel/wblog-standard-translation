   {
    "id": "p_00064",
    "type": "p",
    "path": [
     2,
     3,
     51,
     1
    ],
    "text": "A future version of this standard may disallow setting [I50]errno[/I50] to [EPROTONOSUPPORT] or [EPROTOTYPE] when the socket type is\nnot supported and [I51]protocol[/I51] is zero.",
    "placeholders": {
