   {
    "id": "blockquote_00002",
    "type": "blockquote",
    "path": [
     2,
     3,
     2,
     13
    ],
    "text": "getenv, secure_getenv — get value of an environment variable",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00003",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     15
    ],
    "text": "[A2][/A2]SYNOPSIS",
    "placeholders": {
