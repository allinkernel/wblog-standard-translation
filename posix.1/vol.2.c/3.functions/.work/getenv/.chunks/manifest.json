   {
    "id": "h5_00020",
    "type": "h5",
    "path": [
     2,
     3,
     2,
     37,
     1
    ],
    "text": "[A43][/A43]Getting the Value of an Environment Variable",
    "placeholders": {
     "A43": {
      "open": "<a name=\"tag_17_210_06_01\" id=\"tag_17_210_06_01\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00021",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     3
    ],
    "text": "The following example gets the value of the [I44]HOME[/I44] environment variable.",
    "placeholders": {
     "I44": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "h4_00022",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     39
    ],
    "text": "[A45][/A45]APPLICATION USAGE",
    "placeholders": {
     "A45": {
      "open": "<a name=\"tag_17_210_07\" id=\"tag_17_210_07\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00023",
    "type": "p",
    "path": [
