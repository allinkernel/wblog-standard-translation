   {
    "id": "p_00007",
    "type": "p",
    "path": [
     2,
     3,
     2,
     21,
     5
    ],
    "text": "[S21][[A22]CX[/A22]][/S21] [IMG23] The\npointer returned by [I24]getenv[/I24]() shall point to a string within the environment data pointed to by [I25]environ[/I25].",
    "placeholders": {
     "S21": {
      "open": "<sup>",
      "close": "</sup>",
      "translate": true
     },
     "A22": {
      "open": "<a href=\"javascript:open_code(&#x27;CX&#x27;)\">",
