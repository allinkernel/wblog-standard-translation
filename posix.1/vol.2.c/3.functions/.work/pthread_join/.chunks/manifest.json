   {
    "id": "p_00038",
    "type": "p",
    "path": [
     2,
     3,
     53,
     3
    ],
    "text": "XBD [A74][I75]4.15.2 Memory Synchronization[/I75][/A74], [A76][I77]&lt;pthread.h&gt;[/I77][/A76]",
    "placeholders": {
     "A74": {
      "open": "<a href=\"../basedefs/V1_chap04.html#tag_04_15_02\">",
      "close": "</a>",
      "translate": true
     },
     "I75": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A76": {
      "open": "<a href=\"../basedefs/pthread.h.html\">",
      "close": "</a>",
      "translate": true
     },
     "I77": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "h4_00039",
    "type": "h4",
    "path": [
     2,
     3,
     55
    ],
    "text": "[A78][/A78]CHANGE HISTORY",
    "placeholders": {
     "A78": {
      "open": "<a name=\"tag_17_434_11\" id=\"tag_17_434_11\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00040",
    "type": "p",
    "path": [
     2,
     3,
     57,
     1
    ],
    "text": "First released in Issue 5. Included for alignment with the POSIX Threads Extension.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00041",
    "type": "h4",
    "path": [
     2,
     3,
     59
    ],
    "text": "[A79][/A79]Issue 6",
    "placeholders": {
     "A79": {
      "open": "<a name=\"tag_17_434_12\" id=\"tag_17_434_12\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00042",
    "type": "p",
    "path": [
     2,
     3,
     61,
     1
    ],
    "text": "The [I80]pthread_join[/I80]() function is marked as part of the Threads option.",
    "placeholders": {
     "I80": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00043",
    "type": "p",
    "path": [
     2,
     3,
     61,
     3
    ],
    "text": "IEEE&nbsp;Std&nbsp;1003.1-2001/Cor&nbsp;2-2004, item XSH/TC2/D6/97 is applied, updating the ERRORS section so that the [EINVAL]\nerror is made optional and the words &quot;the implementation has detected&quot; are removed from it.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00044",
    "type": "h4",
    "path": [
     2,
     3,
     63
    ],
    "text": "[A81][/A81]Issue 7",
    "placeholders": {
     "A81": {
      "open": "<a name=\"tag_17_434_13\" id=\"tag_17_434_13\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00045",
    "type": "p",
    "path": [
     2,
     3,
     65,
     1
    ],
    "text": "The [I82]pthread_join[/I82]() function is moved from the Threads option to the Base.",
    "placeholders": {
     "I82": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00046",
    "type": "p",
    "path": [
     2,
     3,
     65,
     3
    ],
    "text": "Austin Group Interpretation 1003.1-2001 #142 is applied, removing the [ESRCH] error condition.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00047",
    "type": "p",
    "path": [
     2,
     3,
     65,
     5
    ],
    "text": "The [EINVAL] error for a non-joinable thread is removed; this condition results in undefined behavior.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00048",
    "type": "p",
    "path": [
     2,
     3,
     65,
     7
    ],
    "text": "The [EDEADLK] error for the calling thread is removed; this condition results in undefined behavior.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00049",
    "type": "h4",
    "path": [
     2,
     3,
     67
    ],
    "text": "[A83][/A83]Issue 8",
    "placeholders": {
     "A83": {
      "open": "<a name=\"tag_17_434_14\" id=\"tag_17_434_14\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00050",
    "type": "p",
    "path": [
     2,
     3,
     69,
     1
    ],
    "text": "Austin Group Defect 792 is applied, changing &quot;a thread that has exited but remains unjoined&quot; to &quot;a zombie thread&quot;.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00051",
    "type": "p",
    "path": [
     2,
     3,
     69,
     3
    ],
    "text": "Austin Group Defect 1302 is applied, updating the page to account for the addition of [A84][I85]&lt;threads.h&gt;[/I85][/A84] interfaces.",
    "placeholders": {
     "A84": {
      "open": "<a href=\"../basedefs/threads.h.html\">",
      "close": "</a>",
      "translate": true
     },
     "I85": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
