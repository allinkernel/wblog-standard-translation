   {
    "id": "p_00024",
    "type": "p",
    "path": [
     2,
     3,
     2,
     45,
     1
    ],
    "text": "Some implementations set [I55]errno[/I55] to [EAGAIN] to signal memory allocation failures that might succeed if retried and\n[ENOMEM] for failures that are unlikely to ever succeed, for example due to configured limits. [A56][I57]2.3 Error Numbers[/I57][/A56] permits this behavior; when multiple error conditions are\nsimultaneously true there is no precedence between them.",
    "placeholders": {
     "I55": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A56": {
      "open": "<a href=\"../functions/V2_chap02.html#tag_16_03\">",
      "close": "</a>",
      "translate": true
     },
