   {
    "id": "p_00033",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     1
    ],
    "text": "Extensions beyond the ISO&nbsp;C standard are marked.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00034",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     3
    ],
    "text": "The following new requirements on POSIX implementations derive from alignment with the Single UNIX Specification:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00035",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     5,
     1,
     1
    ],
    "text": "In the RETURN VALUE section, the requirement to set [I76]errno[/I76] to indicate an error is added.",
    "placeholders": {
     "I76": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00036",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     5,
     3,
     1
