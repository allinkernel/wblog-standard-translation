     3,
     3
    ],
    "text": "[EAGAIN]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00045",
    "type": "dd",
    "path": [
     2,
     3,
     2,
     29,
     3,
     5
    ],
    "text": "The mutex could not be acquired because the maximum number of recursive locks for [I43]mutex[/I43] has been exceeded.",
    "placeholders": {
     "I43": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
