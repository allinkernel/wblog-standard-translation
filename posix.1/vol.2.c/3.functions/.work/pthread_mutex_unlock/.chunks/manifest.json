     3,
     7
    ],
    "text": "[EAGAIN]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00047",
    "type": "dd",
    "path": [
     2,
     3,
     2,
     29,
     3,
     9
    ],
    "text": "The mutex is a robust mutex and the system resources available for robust mutexes owned would be exceeded.",
    "placeholders": {},
    "context": null
   },
   {
