   {
    "id": "p_00043",
    "type": "p",
    "path": [
     2,
     3,
     2,
     29,
     1
    ],
    "text": "The [I41]pthread_mutex_lock[/I41]() and [I42]pthread_mutex_trylock[/I42]() functions shall fail if:",
    "placeholders": {
     "I41": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I42": {
      "open": "<i>",
