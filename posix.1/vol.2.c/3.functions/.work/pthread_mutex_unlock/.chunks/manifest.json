      "open": "",
      "close": "",
      "translate": false,
      "raw": "<code><tt>#include &lt;<a href=\"../basedefs/pthread.h.html\">pthread.h</a>&gt;<br>\n<br>\nint pthread_mutex_lock(pthread_mutex_t *</tt><i>mutex</i><tt>);<br>\nint pthread_mutex_trylock(pthread_mutex_t *</tt><i>mutex</i><tt>);<br>\nint pthread_mutex_unlock(pthread_mutex_t *</tt><i>mutex</i><tt>);<br></tt></code>"
