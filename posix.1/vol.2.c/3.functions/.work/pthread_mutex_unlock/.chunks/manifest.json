    "path": [
     2,
     3,
     2,
     53,
     1
    ],
    "text": "[A65][I66]pthread_mutex_clocklock[/I66]()[/A65], [A67][I68]pthread_mutex_consistent[/I68]()[/A67], [A69][I70]pthread_mutex_destroy[/I70]()[/A69], [A71][I72]pthread_mutexattr_getrobust[/I72]()[/A71]",
    "placeholders": {
     "A65": {
      "open": "<a href=\"../functions/pthread_mutex_clocklock.html#\">",
