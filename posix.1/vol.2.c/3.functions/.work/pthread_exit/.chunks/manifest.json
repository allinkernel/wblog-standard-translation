      "open": "<a name=\"tag_17_430_09\" id=\"tag_17_430_09\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00024",
    "type": "p",
    "path": [
     2,
     3,
     49,
     1
    ],
    "text": "None.",
    "placeholders": {},
    "context": null
   },
