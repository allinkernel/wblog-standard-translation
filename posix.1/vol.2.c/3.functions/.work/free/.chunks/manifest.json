    "placeholders": {
     "CODE3": {
      "open": "",
      "close": "",
      "translate": false,
      "raw": "<code><tt>#include &lt;<a href=\"../basedefs/stdlib.h.html\">stdlib.h</a>&gt;<br>\n<br>\nvoid free(void *</tt><i>ptr</i><tt>);<br></tt></code>"
     }
