   {
    "id": "p_00018",
    "type": "p",
    "path": [
     2,
     3,
     2,
     41,
     3
    ],
    "text": "Because the [I78]free[/I78]() function does not modify [I79]errno[/I79] for valid pointers, it is safe to use it in cleanup code without\ncorrupting earlier errors, such as in this example code:",
    "placeholders": {
     "I78": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I79": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00019",
    "type": "p",
    "path": [
     2,
     3,
     2,
     41,
     7
    ],
    "text": "However, earlier versions of this standard did not require this, and the same example had to be written as:",
    "placeholders": {},
    "context": null
