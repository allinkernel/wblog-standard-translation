   {
    "id": "p_00040",
    "type": "p",
    "path": [
     2,
     3,
     2,
     53,
     1
    ],
    "text": "[A57][/A57][A58]exec[/A58], [A59][I60]kill[/I60]()[/A59], [A61][I62]sigaction[/I62]()[/A61], [A63][I64]sigaddset[/I64]()[/A63], [A65][I66]sigdelset[/I66]()[/A65], [A67][I68]sigemptyset[/I68]()[/A67], [A69][I70]sigfillset[/I70]()[/A69],\n[A71][I72]sigismember[/I72]()[/A71], [A73][I74]sigpending[/I74]()[/A73]\n, [A75][I76]sigqueue[/I76]()[/A75], [A77][I78]sigsuspend[/I78]()[/A77]",
    "placeholders": {
     "A57": {
      "open": "<a href=\"../functions/exec.html#tag_17_129\">",
      "close": "</a>",
      "translate": true
     },
     "A58": {
      "open": "<a href=\"../functions/exec.html\">",
      "close": "</a>",
      "translate": true
     },
     "A59": {
      "open": "<a href=\"../functions/kill.html#tag_17_296\">",
      "close": "</a>",
      "translate": true
     },
     "I60": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A61": {
      "open": "<a href=\"../functions/sigaction.html#\">",
      "close": "</a>",
      "translate": true
     },
     "I62": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A63": {
      "open": "<a href=\"../functions/sigaddset.html#\">",
      "close": "</a>",
      "translate": true
     },
     "I64": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A65": {
