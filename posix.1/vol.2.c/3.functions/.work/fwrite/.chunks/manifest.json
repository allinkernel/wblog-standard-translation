   {
    "id": "p_00009",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     1
    ],
    "text": "The [I28]fwrite[/I28]() function shall return the number of elements successfully written, which shall be less than [I29]nitems[/I29]\nonly if a write error is encountered. If [I30]size[/I30] or [I31]nitems[/I31] is 0, [I32]fwrite[/I32]() shall return 0 and the state of the\nstream remains unchanged. Otherwise, if a write error occurs, the error indicator for the stream shall be set, [S33][[A34]CX[/A34]][/S33] [IMG35] &nbsp;and\n[I36]errno[/I36] shall be set to indicate the error. [IMG37]",
    "placeholders": {
     "I28": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I29": {
      "open": "<i>",
      "close": "</i>",
