    "path": [
     2,
     3,
     2,
     13
    ],
    "text": "fstat — get file status",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00003",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     15
    ],
    "text": "[A2][/A2]SYNOPSIS",
    "placeholders": {
     "A2": {
      "open": "<a name=\"tag_17_189_02\" id=\"tag_17_189_02\">",
      "close": "</a>",
      "translate": true
     }
