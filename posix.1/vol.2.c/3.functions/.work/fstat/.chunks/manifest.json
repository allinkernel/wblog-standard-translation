   {
    "id": "p_00028",
    "type": "p",
    "path": [
     2,
     3,
     2,
     37,
     3
    ],
    "text": "The following example shows how to obtain file status information for a file named [B58]/home/cnd/mod1[/B58]. The structure variable\n[I59]buffer[/I59] is defined for the [B60]stat[/B60] structure. The [B61]/home/cnd/mod1[/B61] file is opened with read/write privileges and is\npassed to the open file descriptor [I62]fildes[/I62].",
    "placeholders": {
     "B58": {
      "open": "<b>",
      "close": "</b>",
      "translate": true
     },
