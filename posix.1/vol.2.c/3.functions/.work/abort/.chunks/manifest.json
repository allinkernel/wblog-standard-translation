      "close": "</i>",
      "translate": true
     },
     "A29": {
      "open": "<a href=\"../functions/waitid.html\">",
      "close": "</a>",
      "translate": true
     },
     "I30": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A31": {
      "open": "<a href=\"../functions/waitpid.html\">",
      "close": "</a>",
      "translate": true
     },
     "I32": {
