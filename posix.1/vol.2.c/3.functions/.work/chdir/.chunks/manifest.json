    "type": "dt",
    "path": [
     2,
     3,
     29,
     3,
     11
    ],
    "text": "[ENAMETOOLONG]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00016",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     3,
     13
    ],
    "text": "The length of a component of a pathname is longer than {NAME_MAX}.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dt_00017",
    "type": "dt",
    "path": [
     2,
     3,
     29,
     3,
     15
    ],
    "text": "[ENOENT]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00018",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     3,
     17
    ],
    "text": "A component of [I13]path[/I13] does not name an existing directory or [I14]path[/I14] is an empty string.",
    "placeholders": {
     "I13": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I14": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
