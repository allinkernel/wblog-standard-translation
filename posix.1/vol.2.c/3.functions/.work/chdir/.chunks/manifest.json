    "type": "dt",
    "path": [
     2,
     3,
     29,
     3,
     19
    ],
    "text": "[ENOTDIR]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00020",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     3,
     21
    ],
    "text": "A component of the pathname names an existing file that is neither a directory nor a symbolic link to a directory.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00021",
    "type": "p",
    "path": [
     2,
     3,
     29,
     5
    ],
    "text": "The [I15]chdir[/I15]() function may fail if:",
    "placeholders": {
     "I15": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "dt_00022",
    "type": "dt",
    "path": [
     2,
     3,
     29,
     7,
     3
    ],
    "text": "[ELOOP]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00023",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     7,
     5
    ],
    "text": "More than {SYMLOOP_MAX} symbolic links were encountered during resolution of the [I16]path[/I16] argument.",
    "placeholders": {
     "I16": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "dt_00024",
    "type": "dt",
    "path": [
     2,
     3,
     29,
     7,
     7
    ],
    "text": "[ENAMETOOLONG]",
    "placeholders": {},
    "context": null
   },
   {
    "id": "dd_00025",
    "type": "dd",
    "path": [
     2,
     3,
     29,
     7,
     9
    ],
    "text": "The length of a pathname exceeds {PATH_MAX}, or pathname resolution of a symbolic link produced an intermediate result with a\nlength that exceeds {PATH_MAX}.",
    "placeholders": {},
    "context": null
   },
   {
