   {
    "id": "p_00011",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     1
    ],
    "text": "Upon successful completion, [I23]fclose[/I23]() shall return 0; otherwise, it shall return EOF [S24][[A25]CX[/A25]][/S24] [IMG26] &nbsp;and set\n[I27]errno[/I27] to indicate the error. [IMG28]",
    "placeholders": {
