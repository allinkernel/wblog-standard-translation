      "close": "</i>",
      "translate": true
     },
     "A98": {
      "open": "<a href=\"../functions/atexit.html\">",
      "close": "</a>",
      "translate": true
     },
     "I99": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I100": {
