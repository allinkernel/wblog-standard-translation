     2,
     13
    ],
    "text": "raise — send a signal to the executing process",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00003",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     15
    ],
    "text": "[A2][/A2]SYNOPSIS",
