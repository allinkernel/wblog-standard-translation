    "id": "p_00009",
    "type": "p",
    "path": [
     2,
     3,
     2,
     25,
     1
    ],
    "text": "Upon successful completion, 0 shall be returned. Otherwise, a non-zero value shall be returned [S17][[A18]CX[/A18]][/S17] [IMG19] &nbsp;and\n[I20]errno[/I20] shall be set to indicate the error. [IMG21]",
    "placeholders": {
