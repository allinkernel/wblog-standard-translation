   {
    "id": "p_00063",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     1
    ],
    "text": "The following new requirements on POSIX implementations derive from alignment with the Single UNIX Specification:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00064",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     3,
     1,
     1
    ],
    "text": "The DESCRIPTION is updated to indicate the results of naming a symbolic link in [I74]path[/I74].",
    "placeholders": {
     "I74": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00065",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     3,
     3,
     1
    ],
    "text": "The [EIO] mandatory error condition is added.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00066",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     3,
     5,
     1
    ],
    "text": "The [ELOOP] mandatory error condition is added.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00067",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     3,
     7,
     1
    ],
    "text": "A second [ENAMETOOLONG] is added as an optional error condition.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00068",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     5
    ],
    "text": "The following changes were made to align with the IEEE&nbsp;P1003.1a draft standard:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00069",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     7,
     1,
     1
    ],
    "text": "The [ELOOP] optional error condition is added.",
    "placeholders": {},
    "context": null
   },
