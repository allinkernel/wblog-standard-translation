   {
    "id": "p_00036",
    "type": "p",
    "path": [
     2,
     3,
     2,
     57,
     1
    ],
    "text": "First released in Issue 3.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00037",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     59
    ],
    "text": "[A49][/A49]Issue 5",
    "placeholders": {
     "A49": {
      "open": "<a name=\"tag_17_192_12\" id=\"tag_17_192_12\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00038",
    "type": "p",
    "path": [
     2,
     3,
     2,
     61,
     1
    ],
    "text": "Aligned with [I50]fsync[/I50]() in the POSIX Realtime Extension. Specifically, the DESCRIPTION and RETURN VALUE sections are much\nexpanded, and the ERRORS section is updated to indicate that [I51]fsync[/I51]() can return the error conditions defined for [A52][I53]read[/I53]()[/A52] and [A54][I55]write[/I55]()[/A54].",
    "placeholders": {
     "I50": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "I51": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A52": {
      "open": "<a href=\"../functions/read.html\">",
      "close": "</a>",
      "translate": true
     },
     "I53": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     },
     "A54": {
      "open": "<a href=\"../functions/write.html\">",
      "close": "</a>",
      "translate": true
     },
     "I55": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "h4_00039",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     63
    ],
    "text": "[A56][/A56]Issue 6",
    "placeholders": {
     "A56": {
      "open": "<a name=\"tag_17_192_13\" id=\"tag_17_192_13\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00040",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     1
    ],
    "text": "This function is marked as part of the File Synchronization option.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00041",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     3
    ],
    "text": "The following new requirements on POSIX implementations derive from alignment with the Single UNIX Specification:",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00042",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     5,
     1,
     1
    ],
    "text": "The [EINVAL] and [EIO] mandatory error conditions are added.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00043",
    "type": "p",
    "path": [
     2,
     3,
     2,
     65,
     7
    ],
    "text": "IEEE&nbsp;Std&nbsp;1003.1-2001/Cor&nbsp;2-2004, item XSH/TC2/D6/44 is applied, applying an editorial rewording of the\nDESCRIPTION. No change in meaning is intended.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00044",
    "type": "h4",
    "path": [
     2,
     3,
     2,
     67
    ],
    "text": "[A57][/A57]Issue 8",
    "placeholders": {
