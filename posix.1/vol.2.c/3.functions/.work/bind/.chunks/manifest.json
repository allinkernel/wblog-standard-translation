    "type": "p",
    "path": [
     2,
     3,
     61,
     1
    ],
    "text": "Austin Group Interpretation 1003.1-2001 #044 is applied, changing the &quot;may fail&quot; [ENOBUFS] error to become a &quot;shall fail&quot;\nerror.",
    "placeholders": {},
    "context": null
