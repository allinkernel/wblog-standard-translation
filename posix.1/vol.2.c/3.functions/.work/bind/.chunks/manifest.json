    "context": null
   },
   {
    "id": "p_00098",
    "type": "p",
    "path": [
     2,
     3,
     65,
     5
    ],
    "text": "Austin Group Defect 561 is applied, changing the requirements for the [I79]sun_path[/I79] member of the [B80]sockaddr_un[/B80]\nstructure.",
    "placeholders": {
     "I79": {
      "open": "<i>",
      "close": "</i>",
      "translate": true
