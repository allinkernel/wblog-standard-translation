      "open": "<a name=\"tag_17_533_08\" id=\"tag_17_533_08\">",
      "close": "</a>",
      "translate": true
     }
    },
    "context": null
   },
   {
    "id": "p_00037",
    "type": "p",
    "path": [
     2,
     3,
     45,
     1
    ],
