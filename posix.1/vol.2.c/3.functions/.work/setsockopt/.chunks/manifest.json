   {
    "id": "p_00044",
    "type": "p",
    "path": [
     2,
     3,
     57,
     1
    ],
    "text": "First released in Issue 6. Derived from the XNS, Issue 5.2 specification.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "p_00045",
    "type": "p",
    "path": [
     2,
     3,
     57,
     3
    ],
    "text": "IEEE&nbsp;Std&nbsp;1003.1-2001/Cor&nbsp;2-2004, item XSH/TC2/D6/125 is applied, updating the SO_LINGER option in the DESCRIPTION\nto refer to the calling thread rather than the process.",
    "placeholders": {},
    "context": null
   },
   {
    "id": "h4_00046",
    "type": "h4",
    "path": [
     2,
     3,
     59
    ],
    "text": "[A63][/A63]Issue 7",
    "placeholders": {
